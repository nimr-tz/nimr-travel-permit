# This directory is the APPLICATION ROOT, not a web root.
#
# It contains .env, the SQLite database, logs, private uploads, and all source
# code. Nothing in here may ever be served over HTTP. Only ./public may be
# exposed, and it must be exposed as a virtual host DocumentRoot -- never by
# dropping this folder inside a server's document root.
#
# See docs/apache-vhost.conf for a ready-made XAMPP/Apache virtual host.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
